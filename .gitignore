
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# tool data dirs (managed by `ddl init --gates`)
.testaruda/
.pretender/

# Rust build output
/target

# kaya incremental build state and capture lock (local caches; ledger, seeds,
# and projections are committed)
.kaya/build-state.json
.kaya/capture.lock

# mdBook build output (the Docs workflow builds and uploads it fresh)
/book/

# OpenSpec spec copies are CI build artifacts (docs.yml copies them at build time)
docs/src/specs/
